{
  "name": "sympa-api",
  "type": "module",
  "private": true,
  "packageManager": "yarn@4.18.0",
  "scripts": {
    "dev": "dotenv-checker && vite --host",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:e2e": "npx playwright install && playwright test",
    "lint": "eslint src/main/webapp/src/",
    "postinstall": "husky",
    "changelog:generate": "commit-and-tag-version --packageFiles pom.xml --skip.bump --skip.tag --skip.commit -t ''"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.2.0",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@gip-recia/ui": "^1.0.5",
    "@types/node": "^24",
    "@types/xml2js": "^0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "commit-and-tag-version": "^13.1.2",
    "dotenv": "^17.4.2",
    "dotenv-checker": "^1.1.7",
    "eslint": "^10.8.0",
    "eslint-plugin-format": "^2.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "npm-run-all2": "^9.0.3",
    "ress": "^5.0.2",
    "sass": "^1.102.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.2.0",
    "xml2js": "^0.6.2"
  }
}
